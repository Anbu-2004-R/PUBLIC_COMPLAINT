# GEMINI_API_KEY: Required for Gemini AI API calls (if server side AI is enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host application URL
APP_URL="MY_APP_URL"

# Application Mode: "demo" (mock in-memory state with preloaded accounts) or "real" (Spring Boot REST backend)
VITE_API_MODE="demo"

# Backend REST API base URL (used when VITE_API_MODE="real")
VITE_API_BASE_URL="/api/v1"

# Phone number prefix / validation standard (default: Indian mobile numbers with +91)
VITE_PHONE_DEFAULT_PREFIX="+91"
