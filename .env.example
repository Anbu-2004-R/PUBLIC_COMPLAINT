# Frontend Environment Configuration (Vite)

# API Mode: 'demo' (runs with local in-memory mock store) or 'real' (connects to live backend)
VITE_API_MODE=demo

# Backend API base URL for real mode (e.g. /api/v1 for same-host proxy or https://civicpulse-api.onrender.com/api/v1)
VITE_API_BASE_URL=/api/v1

# Default phone country prefix for citizen registration
VITE_PHONE_DEFAULT_PREFIX=+91

# Gemini API Key (if AI Studio generative capabilities are used)
GEMINI_API_KEY=